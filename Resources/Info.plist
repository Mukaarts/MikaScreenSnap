    <string>public.app-category.utilities</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Michael Ferreira · daumedia.lu · MIT licence</string>
    <!-- Answers the export compliance question once, in the bundle, instead of on
         every single upload. True for this app: it encrypts nothing. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>SUFeedURL</key>
    <string>https://raw.githubusercontent.com/daumedia/MikaScreenSnap/main/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>eauiHgP4PM9ynLekAmo3URrX3ye3HW7D53xOZa5AeYI=</string>
